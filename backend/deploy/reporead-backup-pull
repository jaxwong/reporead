#!/bin/bash
# Runs on the developer's Mac, daily from launchd (org.reporead.backup-pull): copies the VM's newest nightly database
# dump into ~/Backups/reporead (0700) and keeps the newest 30, so losing the VM does not lose highlights, cards and
# the review log. Its key can only run reporead-backup-latest on the VM (the backup user's forced command), and the
# VM's host key must already be known. The dumps quote private notes: they stay on this Mac. Installed as
# ~/.config/reporead/reporead-backup-pull.
set -euo pipefail

BACKUP_DIR="$HOME/Backups/reporead"
RETENTION_COUNT=30

umask 077
mkdir -p "$BACKUP_DIR"
backup_path="$BACKUP_DIR/reporead-$(date +%Y-%m-%d).dump"
partial_path="$backup_path.partial"
trap 'rm -f "$partial_path"' EXIT
ssh -T -i "$HOME/.ssh/reporead_backup" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes \
    backup@152.69.219.238 > "$partial_path"
# A pg_dump custom-format archive starts with PGDMP; anything else is not a backup.
if [ "$(head -c 5 "$partial_path")" != PGDMP ]; then
  echo "reporead-backup-pull: the VM did not send a pg_dump archive" >&2
  exit 1
fi
mv "$partial_path" "$backup_path"
echo "reporead-backup-pull: $(date) $(basename "$backup_path"), $(stat -f %z "$backup_path") bytes"
ls -1 "$BACKUP_DIR"/reporead-*.dump | sort -r | tail -n +$((RETENTION_COUNT + 1)) | xargs rm -f --
