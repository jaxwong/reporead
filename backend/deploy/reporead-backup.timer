# Installed as /etc/systemd/system/reporead-backup.timer (systemctl enable --now reporead-backup.timer). Persistent:
# a run missed while the VM was down happens at the next boot.
[Unit]
Description=Nightly RepoRead database dump

[Timer]
OnCalendar=*-*-* 18:30:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
