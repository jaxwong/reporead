#!/bin/bash
# Dumps the RepoRead database into /var/lib/reporead-backups (root only) as a nightly or a deploy dump, and keeps the
# newest 14 of that kind; dumps taken by hand there (reporead-*.dump, before migrations) are never removed. Installed as
# /usr/local/sbin/reporead-backup (root 0755); run nightly by reporead-backup.timer, and by reporead-deploy before each
# restart as `reporead-backup deploy`, so deploys never push nightly dumps out. A dump pg_restore cannot list is not
# kept. The GitHub token key (/etc/reporead/github-token-key) is not in the dump, so a dump alone holds no usable
# credential; restoring without the key works, and every user signs in again.
set -euo pipefail

BACKUP_DIR=/var/lib/reporead-backups
RETENTION_COUNT=14
BACKUP_KIND=${1:-nightly}
if [[ $BACKUP_KIND != nightly && $BACKUP_KIND != deploy ]]; then
  echo "reporead-backup: the kind of dump must be nightly or deploy, not $BACKUP_KIND" >&2
  exit 64
fi

umask 077
backup_path="$BACKUP_DIR/$BACKUP_KIND-$(date -u +%Y-%m-%dT%H%M%SZ).dump"
partial_path="$backup_path.partial"
trap 'rm -f "$partial_path"' EXIT
podman exec reporead-postgres pg_dump --username=reporead --dbname=reporead --format=custom > "$partial_path"
podman exec -i reporead-postgres pg_restore --list < "$partial_path" > /dev/null
mv "$partial_path" "$backup_path"
echo "reporead-backup: wrote $(basename "$backup_path"), $(stat -c %s "$backup_path") bytes"
ls -1 "$BACKUP_DIR"/"$BACKUP_KIND"-*.dump | sort -r | tail -n +$((RETENTION_COUNT + 1)) | xargs -r rm --
