# Gradle, Kotlin, and generated build output
.gradle/
.kotlin/
build/

# Local IDE and Android SDK configuration
.idea/
.vscode/
local.properties
*.iml

# Installed JavaScript dependencies and Python bytecode
node_modules/
__pycache__/
*.py[co]

# OS metadata and runtime logs
.DS_Store
*.log
