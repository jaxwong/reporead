# Local environment files; sanitized templates may be committed
.env
.env.*
!.env.example
!.env.sample

# Credentials and signing material; keep real secrets outside Git repositories
/.secrets/
client secret.md
github-client-secret
*.pem
*.key
*.jks
*.keystore
*.p12
*.pfx

# Packaged Android artifacts and private Stage 0 note snapshots
*.apk
*.aab
stage0-note.*
reader-proof.html
